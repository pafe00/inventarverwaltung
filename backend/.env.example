# ===== SICHERHEIT =====
# JWT Secret – MUSS generiert werden (mindestens 32 Zeichen)
# Generiere mit: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-here-min-32-chars

# ===== DATENBANKVERBINDUNG =====
# SQL Server Details – NIEMALS in Git committen
SQL_SERVER=tcp:inventarsqlg6.database.windows.net,1433
SQL_DATABASE=inventarsqlg6
SQL_USER=inventaradmin
SQL_PASSWORD=your-db-password-here

# Optional: ODBC Driver (default: "ODBC Driver 18 for SQL Server")
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Optional: Encryption Settings
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
SQL_TIMEOUT=30

# ===== CORS =====
# Erlaubte Origins (kommagetrennt)
CORS_ALLOW_ORIGINS=https://inventarfrontend-xxx.azurewebsites.net,http://localhost:5173

# ===== LOGGING =====
# LOG_LEVEL=INFO
